<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters: real drone and closed-loop simulation (HIL follows in M5)</description>
  <maintainer email="thuyxn2006@gmail.com">Do Minh Hien</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>uav_perception</exec_depend>
  <exec_depend>uav_mission</exec_depend>
  <exec_depend>uav_hardware</exec_depend>
  <exec_depend>uav_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
