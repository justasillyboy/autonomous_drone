# Binary assets live in the GitHub Release `legacy-assets-v0`; fetch them with
# scripts/fetch_assets.sh. Only the checksum manifest is tracked.
/assets/*
!/assets/SHA256SUMS
*.pt
*.onnx
*.hef
*.mp4
*.zip
*.npz

# Private material (competition rulebook, internal docx) — never published
docs/private/
/private/

# Data and training outputs
data/
runs/

# Python. `.venv` is a symlink to `.venv.nosync` so iCloud skips the environment.
.venv
*.nosync
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# Local scratch work
.wip/

# ROS 2 / colcon
build/
install/
log/

# OS / editor
.DS_Store
__MACOSX/

# Local experiment dumps (large binaries and generated files; not part of the repo)
/fixed_yolo_circle_seg/
/yolo_circle_seg/

# simulation outputs (referee JSON, generated worlds)
/results/
/docker/wheels/*.whl
