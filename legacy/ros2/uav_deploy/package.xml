<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>uav_deploy</name>
  <version>0.0.0</version>
  <description>UAV ROS2 Python deploy package</description>

  <maintainer email="vandong@todo.todo">vandong</maintainer>
  <license>Apache-2.0</license>

  <!-- 🔥 QUAN TRỌNG -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
<exec_depend>rclpy</exec_depend>
<exec_depend>sensor_msgs</exec_depend>
<exec_depend>geometry_msgs</exec_depend>
<exec_depend>python3-ultralytics</exec_depend>
<exec_depend>python3-adafruit-bno08x</exec_depend>

  <!-- Nếu bạn dùng cv_bridge / opencv -->
  <!-- <exec_depend>cv_bridge</exec_depend> -->

  <!-- Test -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>